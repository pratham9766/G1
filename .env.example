NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Generate distinct 32-byte hex secrets before any shared deployment.
# IDENTITY_KEY=
# CLINICAL_KEY=
# AUDIT_KEY=
# LOOKUP_KEY=
# DATABASE_URL=postgresql://g1:CHANGE_ME@localhost:5432/g1
# REDIS_URL=redis://localhost:6379
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# Private OCR executable; receives input path, outputs plain text on stdout.
# OCR_COMMAND=
# HMIS_WEBHOOK_SECRET=
# ABDM endpoints and protocol must be validated against the current sandbox specification.

# Connected identity workflow: sandbox/production are fail-closed placeholders.
ABDM_MODE=mock
CLINICAL_AI_PROVIDER=local
WORKFLOW_TICK_MS=1000
# Generate a secret of at least 32 characters for synthetic signed callbacks.
# ABDM_WEBHOOK_SECRET=
# Test-only failure switches: never set for a normal demo.
# ABDM_MOCK_FAILURE=retrieval
# CLINICAL_AI_MOCK_FAILURE=true
